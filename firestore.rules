rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can read the directory (contacts, presence), but
    // only the owner can write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // A user's blocked list. Only the owner can write it. Reads are
      // split: the owner can read the whole list, but anyone else can
      // only read the single doc keyed by their own uid -- "am I on this
      // list", not the full list. That's all isBlockedEitherWay needs.
      match /blocked/{blockedUserId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == blockedUserId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // A call record can only be touched by the two people on the call.
    match /calls/{callId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerId;

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);

      allow delete: if false;
    }
  }
}
